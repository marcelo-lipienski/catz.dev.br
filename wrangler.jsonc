{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catz-dev-br",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npm run build"
  }
}
